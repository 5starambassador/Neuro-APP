# --- docker compose ---
# Public DNS name of this server; Caddy gets an HTTPS certificate for it automatically.
FOCUSQUEST_DOMAIN=focus.yourschool.org

# --- server (all optional; defaults shown) ---
# PORT=4000
# HOST=0.0.0.0
# DATA_DIR=./data                  # SQLite database lives here; back it up
# TRUST_PROXY=false                # true behind Caddy/nginx/a PaaS
# REQUIRE_HTTPS=true in production # rejects plain HTTP
# COOKIE_SECURE=true in production
# TLS_CERT=/path/fullchain.pem     # built-in HTTPS instead of a proxy
# TLS_KEY=/path/privkey.pem
# PDF_FONT=/path/NotoSans-Regular.ttf  # for student names in non-Latin scripts (e.g. Tamil, Hindi)
# SESSION_DAYS=7
# LOG_LEVEL=info
